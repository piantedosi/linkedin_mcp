{
  "mcpServers": {
    "linkedin-jobs": {
      "type": "stdio",
      "command": "bash",
      "args": [
        "${workspaceFolder}/mcp_server/run.sh"
      ],
      "envFile": "${workspaceFolder}/mcp_server/.env",
      "env": {
        "LINKEDIN_PROFILE_DIR": "${workspaceFolder}/mcp_server/.browser_profile",
        "PLAYWRIGHT_BROWSERS_PATH": "${workspaceFolder}/mcp_server/.playwright"
      }
    }
  }
}
